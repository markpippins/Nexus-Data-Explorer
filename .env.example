# data-explorer-ui — environment-selected mode is authoritative.
#
# live (default): the workbench connects to a REAL PostgreSQL database. The
# user supplies host/port/database/username/password in the connection modal
# (never hardcoded); schema discovery and query execution go through server.ts
# which opens a per-request connection to that database. Live failures surface
# as visible errors — no seeded sample rows.
#
# mock: set VITE_DATA_EXPLORER_MODE=mock to keep the in-browser localStorage
# simulation with sample schemas.
VITE_DATA_EXPLORER_MODE=live

# Schema model (schema-tree feature):
#   - The connection's "Default Schema" (set in the connection dialog) is only
#     the starting point for new/unqualified queries.
#   - Every schema discovered on the database appears in the tree; any of them
#     can be set ACTIVE from the tree (hover button or right-click menu), and
#     any two schemas can be diffed with the compare affordance.
